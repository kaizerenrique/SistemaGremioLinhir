# =============================================================================
#  LINHIR — Ejemplo de configuración de entorno
# =============================================================================
#  Copia este archivo a ".env" y rellena los valores reales:
#      cp .env.example .env
#      php artisan key:generate
#
#  Rellena los campos marcados con <...>. Los que quedan vacíos son opcionales.
# =============================================================================

# -----------------------------------------------------------------------------
#  APLICACIÓN
# -----------------------------------------------------------------------------
APP_NAME=Linhir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
#  LOGGING
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
#  BASE DE DATOS
# -----------------------------------------------------------------------------
#  Local: SQLite por defecto. Producción: MySQL/MariaDB.
DB_CONNECTION=sqlite

# --- MySQL / MariaDB ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=linhir
# DB_USERNAME=
# DB_PASSWORD=


# -----------------------------------------------------------------------------
#  SESIÓN
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# -----------------------------------------------------------------------------
#  CACHÉ / COLAS / BROADCAST
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=


# -----------------------------------------------------------------------------
#  REDIS / MEMCACHED  [OPCIONAL]
# -----------------------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# -----------------------------------------------------------------------------
#  CORREO
# -----------------------------------------------------------------------------
#  Desarrollo: MAIL_MAILER=log (no envía, escribe en storage/logs).
#  Producción: MAIL_MAILER=smtp y rellenar host/port/user/pass.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
#  AWS / S3  [OPCIONAL]
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# =============================================================================
#  DISCORD
# =============================================================================

# --- 1. OAuth2 (login web y móvil) -------------------------------------------
#  Discord Developer Portal → Applications → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI="${APP_URL}/auth/callback"
DISCORD_REDIRECT_URI_API="${APP_URL}/api/auth/discord/callback"
DISCORD_AVATAR_GIF=true
DISCORD_EXTENSION_DEFAULT=png

# --- 2. Bot de Discord ------------------------------------------------------
#  El bot debe tener habilitado el "Server Members Intent" en el portal.
DISCORD_BOT_TOKEN=
DISCORD_SERVER_LINHIR_TOKEN=
DISCORD_OFFICER_ROLE_ID=

# --- 3. Webhooks ------------------------------------------------------------
#  Canal → Editar → Integraciones → Webhooks → Copiar URL
DISCORD_BLOG_WEBHOOK_URL=
DISCORD_BLOG_MENTION=@everyone
DISCORD_BIRTHDAY_WEBHOOK_URL=
DISCORD_BIRTHDAY_MENTION_ROLE=@everyone


# =============================================================================
#  LINHIR — Variables propias del proyecto
# =============================================================================
LINHIR_GREMIO_ID=
CANAL_ESTADO_SERVIDOR=


# =============================================================================
#  BLOGGER  [OPCIONAL]
# =============================================================================
BLOGGER_API_KEY=
BLOGGER_BLOG_ID=


# =============================================================================
#  OLLAMA (IA local)  [OPCIONAL]
# =============================================================================
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_PROMPT="Hola, ¿cómo puedo ayudarle hoy?"
OLLAMA_CONNECTION_TIMEOUT=300
OLLAMA_KEEP_ALIVE=null
OLLAMA_API_KEY=


# =============================================================================
#  VITE (frontend)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"


# =============================================================================
#  ADMINISTRADOR INICIAL (seeder)
# =============================================================================
ADMIN_INITIAL_EMAIL=admin@admin.com
ADMIN_INITIAL_PASSWORD=cambiar_esta_clave_en_produccion